{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/opaque-witness-record.schema.json",
  "title": "Opaque witness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seq",
    "prev_hash",
    "destruction_authority_root_hash",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "destruction_authority_root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

